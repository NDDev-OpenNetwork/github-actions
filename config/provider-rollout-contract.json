{
  "schema_version": 2,
  "ordered_phases": [
    "source-and-config-verification",
    "services-identity-swap",
    "observer-restart",
    "member-identity-swap",
    "bounded-convergence"
  ],
  "restart_units": [
    "gha-fleet-observer.service"
  ],
  "convergence": {
    "health_required": true,
    "fresh_sample_required": true,
    "collection_errors_must_equal": 0,
    "visible_inventory_must_match_provider": true,
    "queue_identity_must_be_preserved": true,
    "natural_job_required": true
  },
  "conditional_restart_units": [
    "gha-cache-broker.service",
    "gha-pressure-observer.service"
  ],
  "preserve_manager_for_provider_only_update": true
}
