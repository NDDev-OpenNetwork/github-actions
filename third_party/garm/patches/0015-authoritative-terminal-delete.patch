-func (f *failedScaleSetRunnerCleanupHelper) SetInstanceStatus(_ string, status commonParams.InstanceStatus, _ []byte, _ bool) error {
+func (f *failedScaleSetRunnerCleanupHelper) SetInstanceStatus(_ string, status commonParams.InstanceStatus, _ []byte, force bool) error {
 	f.statusCalls++
 	f.status = status
+	f.statuses = append(f.statuses, status)
+	f.forces = append(f.forces, force)
 	return nil
 }
 
+func TestProviderDeleteCommitsTerminalStateAuthoritatively(t *testing.T) {
+	t.Setenv(nddevRetryFileEnv, t.TempDir()+"/retry.json")
+	t.Setenv(nddevRetryLockEnv, t.TempDir()+"/retry.lock")
+	helper := &failedScaleSetRunnerCleanupHelper{}
+	provider := mocks.NewProvider(t)
+	provider.EXPECT().DeleteInstance(mock.Anything, "runner-delete", mock.Anything).Return(nil).Once()
+	manager := &instanceManager{
+		ctx: context.Background(),
+		instance: params.Instance{
+			Name: "runner-delete", Status: commonParams.InstancePendingDelete,
+		},
+		provider: provider,
+		helper:   helper,
+	}
+	manager.running.Store(true)
+
+	if err := manager.consolidateState(); !errors.Is(err, ErrInstanceDeleted) {
+		t.Fatalf("consolidating deleted provider instance: %v", err)
+	}
+	if len(helper.statuses) != 2 || helper.statuses[0] != commonParams.InstanceDeleting ||
+		helper.statuses[1] != commonParams.InstanceDeleted {
+		t.Fatalf("status sequence = %v", helper.statuses)
+	}
+	if len(helper.forces) != 2 || !helper.forces[0] || !helper.forces[1] {
+		t.Fatalf("terminal status was not authoritative: forces=%v", helper.forces)
+	}
+}
