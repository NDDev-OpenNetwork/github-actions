+func TestScaleUpBurstTarget(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		current int
+		target  int
+		want    int
+	}{
+		{current: 0, target: 12, want: 1},
+		{current: 7, target: 12, want: 8},
+		{current: 7, target: 7, want: 7},
+		{current: 8, target: 7, want: 8},
+	}
+	for _, test := range tests {
+		if got := scaleUpBurstTarget(test.current, test.target); got != test.want {
+			t.Fatalf("scaleUpBurstTarget(%d, %d) = %d, want %d", test.current, test.target, got, test.want)
+		}
+	}
+}
