@@ -0,0 +1,111 @@
+package provider
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	runnerErrors "github.com/cloudbase/garm-provider-common/errors"
+	commonParams "github.com/cloudbase/garm-provider-common/params"
+	"github.com/cloudbase/garm/auth"
+	"github.com/cloudbase/garm/params"
+)
+
+type failedScaleSetRunnerCleanupHelper struct {
+	removeErr    error
+	removeCalls  int
+	removedAgent int64
+	statusCalls  int
+	status       commonParams.InstanceStatus
+}
+
+func (f *failedScaleSetRunnerCleanupHelper) SetInstanceStatus(_ string, status commonParams.InstanceStatus, _ []byte, _ bool) error {
+	f.statusCalls++
+	f.status = status
+	return nil
+}
+
+func (*failedScaleSetRunnerCleanupHelper) InstanceTokenGetter() auth.InstanceTokenGetter {
+	return nil
+}
+
+func (*failedScaleSetRunnerCleanupHelper) updateArgsFromProviderInstance(_ string, _ commonParams.ProviderInstance) (params.Instance, error) {
+	return params.Instance{}, nil
+}
+
+func (*failedScaleSetRunnerCleanupHelper) GetControllerInfo() (params.ControllerInfo, error) {
+	return params.ControllerInfo{}, nil
+}
+
+func (*failedScaleSetRunnerCleanupHelper) GetGithubEntity(entity params.ForgeEntity) (params.ForgeEntity, error) {
+	return entity, nil
+}
+
+func (f *failedScaleSetRunnerCleanupHelper) RemoveScaleSetRunner(_ context.Context, _ params.ScaleSet, agentID int64) error {
+	f.removeCalls++
+	f.removedAgent = agentID
+	return f.removeErr
+}
+
+func failedScaleSetInstanceManager(helper providerHelper) *instanceManager {
+	manager := &instanceManager{
+		ctx: context.Background(),
+		instance: params.Instance{
+			Name:       "runner-failed",
+			Status:     commonParams.InstanceError,
+			ScaleSetID: 1,
+			AgentID:    322,
+		},
+		scaleSet: params.ScaleSet{ID: 1},
+		helper:   helper,
+	}
+	manager.running.Store(true)
+	return manager
+}
+
+func TestFailedScaleSetInstanceRemovesJITRegistrationBeforeTeardown(t *testing.T) {
+	helper := &failedScaleSetRunnerCleanupHelper{}
+	manager := failedScaleSetInstanceManager(helper)
+
+	if err := manager.consolidateState(); err != nil {
+		t.Fatalf("consolidating failed instance: %v", err)
+	}
+	if helper.removeCalls != 1 || helper.removedAgent != 322 {
+		t.Fatalf("remove calls=%d agent=%d", helper.removeCalls, helper.removedAgent)
+	}
+	if helper.statusCalls != 1 || helper.status != commonParams.InstancePendingDelete {
+		t.Fatalf("status calls=%d status=%s", helper.statusCalls, helper.status)
+	}
+}
+
+func TestFailedScaleSetInstanceRetainsAgentIDUntilTransientRemovalConverges(t *testing.T) {
+	helper := &failedScaleSetRunnerCleanupHelper{removeErr: errors.New("temporary GitHub failure")}
+	manager := failedScaleSetInstanceManager(helper)
+
+	if err := manager.consolidateState(); err == nil {
+		t.Fatal("expected transient removal failure")
+	}
+	if helper.statusCalls != 0 {
+		t.Fatalf("failed instance advanced to teardown: calls=%d", helper.statusCalls)
+	}
+
+	helper.removeErr = nil
+	if err := manager.consolidateState(); err != nil {
+		t.Fatalf("retrying failed instance: %v", err)
+	}
+	if helper.removeCalls != 2 || helper.statusCalls != 1 || helper.status != commonParams.InstancePendingDelete {
+		t.Fatalf("remove calls=%d status calls=%d status=%s", helper.removeCalls, helper.statusCalls, helper.status)
+	}
+}
+
+func TestFailedScaleSetInstanceAcceptsAlreadyAbsentJITRegistration(t *testing.T) {
+	helper := &failedScaleSetRunnerCleanupHelper{removeErr: runnerErrors.ErrNotFound}
+	manager := failedScaleSetInstanceManager(helper)
+
+	if err := manager.consolidateState(); err != nil {
+		t.Fatalf("consolidating already absent runner: %v", err)
+	}
+	if helper.statusCalls != 1 || helper.status != commonParams.InstancePendingDelete {
+		t.Fatalf("status calls=%d status=%s", helper.statusCalls, helper.status)
+	}
+}
