+
+func (p *Provider) RemoveScaleSetRunner(ctx context.Context, scaleSet params.ScaleSet, agentID int64) error {
+	entity, err := scaleSet.GetEntity()
+	if err != nil {
+		return fmt.Errorf("getting scale set entity: %w", err)
+	}
+	githubClient, ok := cache.GetGithubClient(entity.ID)
+	if !ok {
+		return fmt.Errorf("getting github client for scale set entity %s", entity.ID)
+	}
+	scaleSetClient, err := scalesets.NewClient(githubClient)
+	if err != nil {
+		return fmt.Errorf("creating scale set client: %w", err)
+	}
+	if err := scaleSetClient.RemoveRunner(ctx, agentID); err != nil {
+		return fmt.Errorf("removing scale set runner %d: %w", agentID, err)
+	}
+	return nil
 }
 
 func (p *Provider) updateArgsFromProviderInstance(instanceName string, providerInstance commonParams.ProviderInstance) (params.Instance, error) {
