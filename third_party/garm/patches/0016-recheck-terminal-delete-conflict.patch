+package scaleset
+
+import (
+	"context"
+	"testing"
+
+	runnerErrors "github.com/cloudbase/garm-provider-common/errors"
+	commonParams "github.com/cloudbase/garm-provider-common/params"
+	dbMocks "github.com/cloudbase/garm/database/common/mocks"
+	"github.com/cloudbase/garm/params"
+	"github.com/stretchr/testify/mock"
+)
+
+func TestPendingDeleteConflictAcceptsOnlyAuthoritativeRemovalState(t *testing.T) {
+	for _, test := range []struct {
+		name     string
+		instance params.Instance
+		err      error
+		terminal bool
+	}{
+		{name: "deleted", instance: params.Instance{Name: "runner", Status: commonParams.InstanceDeleted}, terminal: true},
+		{name: "deleting", instance: params.Instance{Name: "runner", Status: commonParams.InstanceDeleting}, terminal: true},
+		{name: "absent", err: runnerErrors.ErrNotFound, terminal: true},
+		{name: "pending delete", instance: params.Instance{Name: "runner", Status: commonParams.InstancePendingDelete}, terminal: true},
+		{name: "error", instance: params.Instance{Name: "runner", Status: commonParams.InstanceError}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			store := dbMocks.NewStore(t)
+			store.EXPECT().GetInstance(mock.Anything, "runner").Return(test.instance, test.err).Once()
+			worker := &Worker{ctx: context.Background(), store: store}
+			terminal, err := worker.runnerRemovalAlreadyOwned("runner")
+			if err != nil {
+				t.Fatal(err)
+			}
+			if terminal != test.terminal {
+				t.Fatalf("terminal=%t, want %t", terminal, test.terminal)
+			}
+		})
+	}
+}
