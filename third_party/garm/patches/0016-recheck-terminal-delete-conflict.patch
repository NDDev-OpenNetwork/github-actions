+func (w *Worker) runnerRemovalAlreadyOwned(runnerName string) (bool, error) {
+	current, err := w.store.GetInstance(w.ctx, runnerName)
+	if err != nil {
+		if errors.Is(err, runnerErrors.ErrNotFound) {
+			return true, nil
+		}
+		return false, fmt.Errorf("refreshing runner %s after pending-delete conflict: %w", runnerName, err)
+	}
+	return providerRemovalProtected(current.Status), nil
+}
