+++ b/workers/scaleset/autoscale_wake_test.go
@@ -0,0 +1,65 @@
+package scaleset
+
+import (
+	"context"
+	"testing"
+
+	dbCommon "github.com/cloudbase/garm/database/common"
+	"github.com/cloudbase/garm/params"
+)
+
+func TestSignalAutoScaleCoalesces(t *testing.T) {
+	w := &Worker{autoscaleWake: make(chan struct{}, 1)}
+	w.signalAutoScale()
+	w.signalAutoScale()
+
+	if got := len(w.autoscaleWake); got != 1 {
+		t.Fatalf("autoscale wake depth = %d, want 1", got)
+	}
+}
+
+func TestScaleSetUpdateSignalsAutoScale(t *testing.T) {
+	w := &Worker{
+		ctx:           context.Background(),
+		scaleSet:      params.ScaleSet{Enabled: true, MaxRunners: 1},
+		autoscaleWake: make(chan struct{}, 1),
+	}
+	updated := params.ScaleSet{Enabled: true, MaxRunners: 1, DesiredRunnerCount: 1}
+	w.handleScaleSetEvent(dbCommon.ChangePayload{
+		Operation: dbCommon.UpdateOperation,
+		Payload:   updated,
+	})
+
+	if w.scaleSet.DesiredRunnerCount != 1 {
+		t.Fatalf("desired runner count = %d, want 1", w.scaleSet.DesiredRunnerCount)
+	}
+	select {
+	case <-w.autoscaleWake:
+	default:
+		t.Fatal("scale set update did not wake autoscaler")
+	}
+}
+
+func TestScaleDownProtectsStartupAndExecutionStates(t *testing.T) {
+	tests := []struct {
+		name      string
+		status    params.RunnerStatus
+		protected bool
+	}{
+		{name: "pending", status: params.RunnerPending, protected: true},
+		{name: "installing", status: params.RunnerInstalling, protected: true},
+		{name: "active", status: params.RunnerActive, protected: true},
+		{name: "terminated", status: params.RunnerTerminated, protected: true},
+		{name: "idle", status: params.RunnerIdle},
+		{name: "failed", status: params.RunnerFailed},
+		{name: "offline", status: params.RunnerOffline},
+		{name: "unknown", status: params.RunnerUnknown},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if got := scaleDownProtected(test.status); got != test.protected {
+				t.Fatalf("scaleDownProtected(%q) = %t, want %t", test.status, got, test.protected)
+			}
+		})
+	}
+}
