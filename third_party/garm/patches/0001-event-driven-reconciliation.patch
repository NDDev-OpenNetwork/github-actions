diff --git a/workers/provider/instance_manager_wake_test.go b/workers/provider/instance_manager_wake_test.go
new file mode 100644
index 0000000..f569786
--- /dev/null
+++ b/workers/provider/instance_manager_wake_test.go
@@ -0,0 +1,13 @@
+package provider
+
+import "testing"
+
+func TestSignalReconcileCoalesces(t *testing.T) {
+	manager := &instanceManager{reconcileWake: make(chan struct{}, 1)}
+	manager.signalReconcile()
+	manager.signalReconcile()
+
+	if got := len(manager.reconcileWake); got != 1 {
+		t.Fatalf("reconcile wake depth = %d, want 1", got)
+	}
+}
