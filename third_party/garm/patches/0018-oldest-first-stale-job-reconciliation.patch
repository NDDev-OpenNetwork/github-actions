+func (s *PoolStressTestSuite) TestOldestQueuedJobsMakesTheBoundedBatchFair() {
+	now := time.Now().UTC()
+	jobs := []params.Job{
+		{ID: 30, CreatedAt: now.Add(-time.Minute)},
+		{ID: 10, CreatedAt: now.Add(-time.Hour)},
+		{ID: 20, CreatedAt: now.Add(-time.Hour)},
+	}
+	ordered := oldestQueuedJobs(jobs)
+	s.Require().Len(ordered, 3)
+	s.Equal(int64(10), ordered[0].ID)
+	s.Equal(int64(20), ordered[1].ID)
+	s.Equal(int64(30), ordered[2].ID)
+	// The store-owned input must not be reordered as a side effect.
+	s.Equal(int64(30), jobs[0].ID)
+}
