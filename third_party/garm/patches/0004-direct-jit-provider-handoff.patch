diff --git a/workers/provider/nddev_direct_jit.go b/workers/provider/nddev_direct_jit.go
new file mode 100644
index 0000000..556e636
--- /dev/null
+++ b/workers/provider/nddev_direct_jit.go
@@ -0,0 +1,65 @@
+package provider
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+)
+
+const (
+	nddevDirectJITEnabledKey = "nddev_direct_jit"
+	nddevEncodedJITKey       = "nddev_encoded_jit_config"
+	nddevMaximumJITJSONBytes = 64 * 1024
+)
+
+// withNDDevDirectJIT is an opt-in transport optimization for the NDDev
+// external provider. GARM remains the sole caller of GitHub's generate-JIT
+// endpoint and the official runner remains the execution engine. The dynamic
+// blob exists only in the provider subprocess request; static scale-set extra
+// specs and the sealed instance record retain their existing representations.
+func withNDDevDirectJIT(extraSpecs json.RawMessage, jitConfiguration map[string]string) (json.RawMessage, error) {
+	if len(extraSpecs) == 0 {
+		return extraSpecs, nil
+	}
+	var specs map[string]json.RawMessage
+	if err := json.Unmarshal(extraSpecs, &specs); err != nil {
+		return nil, fmt.Errorf("decoding extra specs: %w", err)
+	}
+	rawEnabled, enabledPresent := specs[nddevDirectJITEnabledKey]
+	if !enabledPresent {
+		return extraSpecs, nil
+	}
+	var enabled bool
+	if err := json.Unmarshal(rawEnabled, &enabled); err != nil {
+		return nil, fmt.Errorf("%s must be a boolean: %w", nddevDirectJITEnabledKey, err)
+	}
+	if !enabled {
+		return extraSpecs, nil
+	}
+	if _, collision := specs[nddevEncodedJITKey]; collision {
+		return nil, fmt.Errorf("static extra specs contain reserved field %q", nddevEncodedJITKey)
+	}
+	if len(jitConfiguration) == 0 {
+		return nil, fmt.Errorf("direct JIT is enabled without a generated JIT configuration")
+	}
+	jitJSON, err := json.Marshal(jitConfiguration)
+	if err != nil {
+		return nil, fmt.Errorf("encoding JIT configuration: %w", err)
+	}
+	defer clear(jitJSON)
+	if len(jitJSON) > nddevMaximumJITJSONBytes {
+		return nil, fmt.Errorf("JIT configuration is %d bytes, maximum is %d", len(jitJSON), nddevMaximumJITJSONBytes)
+	}
+	encoded := base64.StdEncoding.EncodeToString(jitJSON)
+	encodedJSON, err := json.Marshal(encoded)
+	if err != nil {
+		return nil, fmt.Errorf("encoding direct JIT transport: %w", err)
+	}
+	defer clear(encodedJSON)
+	specs[nddevEncodedJITKey] = encodedJSON
+	result, err := json.Marshal(specs)
+	if err != nil {
+		return nil, fmt.Errorf("encoding provider extra specs: %w", err)
+	}
+	return result, nil
+}
