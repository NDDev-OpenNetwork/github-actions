diff --git a/workers/provider/nddev_direct_jit_test.go b/workers/provider/nddev_direct_jit_test.go
new file mode 100644
index 0000000..0538fb4
--- /dev/null
+++ b/workers/provider/nddev_direct_jit_test.go
@@ -0,0 +1,79 @@
+package provider
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestWithNDDevDirectJITLeavesUnrelatedProvidersByteExact(t *testing.T) {
+	raw := json.RawMessage(`{"disable_updates":true}`)
+	got, err := withNDDevDirectJIT(raw, map[string]string{"runner": "opaque"})
+	if err != nil {
+		t.Fatalf("direct JIT disabled: %v", err)
+	}
+	if string(got) != string(raw) {
+		t.Fatalf("disabled extra specs changed: got %s want %s", got, raw)
+	}
+}
+
+func TestWithNDDevDirectJITInjectsReconstructableEphemeralBlob(t *testing.T) {
+	jit := map[string]string{
+		".runner":                "cnVubmVy",
+		".credentials":           "Y3JlZGVudGlhbHM=",
+		".credentials_rsaparams": "cnNh",
+	}
+	got, err := withNDDevDirectJIT(json.RawMessage(`{"disable_updates":true,"nddev_direct_jit":true}`), jit)
+	if err != nil {
+		t.Fatalf("inject direct JIT: %v", err)
+	}
+	var specs map[string]json.RawMessage
+	if err := json.Unmarshal(got, &specs); err != nil {
+		t.Fatalf("decode injected specs: %v", err)
+	}
+	if string(specs["disable_updates"]) != "true" || string(specs[nddevDirectJITEnabledKey]) != "true" {
+		t.Fatalf("static fields changed: %s", got)
+	}
+	var encoded string
+	if err := json.Unmarshal(specs[nddevEncodedJITKey], &encoded); err != nil {
+		t.Fatalf("decode transport string: %v", err)
+	}
+	rawJIT, err := base64.StdEncoding.DecodeString(encoded)
+	if err != nil {
+		t.Fatalf("decode transport base64: %v", err)
+	}
+	var reconstructed map[string]string
+	if err := json.Unmarshal(rawJIT, &reconstructed); err != nil {
+		t.Fatalf("decode transported JIT: %v", err)
+	}
+	if len(reconstructed) != len(jit) {
+		t.Fatalf("transported JIT keys = %d, want %d", len(reconstructed), len(jit))
+	}
+	for key, want := range jit {
+		if reconstructed[key] != want {
+			t.Fatalf("transported JIT %q = %q, want %q", key, reconstructed[key], want)
+		}
+	}
+}
+
+func TestWithNDDevDirectJITFailsClosed(t *testing.T) {
+	tests := []struct {
+		name string
+		raw  string
+		jit  map[string]string
+		want string
+	}{
+		{name: "invalid flag", raw: `{"nddev_direct_jit":"true"}`, jit: map[string]string{"runner": "x"}, want: "must be a boolean"},
+		{name: "static collision", raw: `{"nddev_direct_jit":true,"nddev_encoded_jit_config":"attacker"}`, jit: map[string]string{"runner": "x"}, want: "reserved field"},
+		{name: "missing JIT", raw: `{"nddev_direct_jit":true}`, want: "without a generated"},
+		{name: "oversized JIT", raw: `{"nddev_direct_jit":true}`, jit: map[string]string{"runner": strings.Repeat("x", nddevMaximumJITJSONBytes)}, want: "maximum"},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if _, err := withNDDevDirectJIT(json.RawMessage(test.raw), test.jit); err == nil || !strings.Contains(err.Error(), test.want) {
+				t.Fatalf("error = %v, want substring %q", err, test.want)
+			}
+		})
+	}
+}
