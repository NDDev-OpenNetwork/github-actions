@@ -0,0 +1,32 @@
+package scaleset
+
+import (
+	"encoding/json"
+
+	"github.com/cloudbase/garm/params"
+)
+
+func nddevDirectJITEnabled(extraSpecs json.RawMessage) bool {
+	if len(extraSpecs) == 0 {
+		return false
+	}
+	var specs struct {
+		Enabled bool `json:"nddev_direct_jit"`
+	}
+	return json.Unmarshal(extraSpecs, &specs) == nil && specs.Enabled
+}
+
+// A direct-JIT runner does not execute GARM's metadata installer callbacks.
+// A GitHub JobStarted message is authoritative proof that the official runner
+// is online and has acquired the job, so bridge only the lifecycle states the
+// callbacks would otherwise have established before applying Active.
+func nddevDirectJITStartedTransitions(current params.RunnerStatus) []params.RunnerStatus {
+	switch current {
+	case params.RunnerPending:
+		return []params.RunnerStatus{params.RunnerInstalling, params.RunnerIdle, params.RunnerActive}
+	case params.RunnerInstalling:
+		return []params.RunnerStatus{params.RunnerIdle, params.RunnerActive}
+	default:
+		return []params.RunnerStatus{params.RunnerActive}
+	}
+}
