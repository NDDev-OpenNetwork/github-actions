@@ -0,0 +1,73 @@
+package scaleset
+
+import (
+	"encoding/json"
+	"slices"
+	"testing"
+
+	"github.com/cloudbase/garm/params"
+)
+
+func TestNDDevDirectJITEnabled(t *testing.T) {
+	for _, test := range []struct {
+		name string
+		raw  string
+		want bool
+	}{
+		{name: "absent", raw: `{"disable_updates":true}`},
+		{name: "disabled", raw: `{"nddev_direct_jit":false}`},
+		{name: "invalid", raw: `{"nddev_direct_jit":"true"}`},
+		{name: "enabled", raw: `{"disable_updates":true,"nddev_direct_jit":true}`, want: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			if got := nddevDirectJITEnabled(json.RawMessage(test.raw)); got != test.want {
+				t.Fatalf("enabled = %t, want %t", got, test.want)
+			}
+		})
+	}
+}
+
+func TestNDDevDirectJITStartedTransitions(t *testing.T) {
+	for _, test := range []struct {
+		name    string
+		current params.RunnerStatus
+		want    []params.RunnerStatus
+	}{
+		{name: "pending", current: params.RunnerPending, want: []params.RunnerStatus{params.RunnerInstalling, params.RunnerIdle, params.RunnerActive}},
+		{name: "installing", current: params.RunnerInstalling, want: []params.RunnerStatus{params.RunnerIdle, params.RunnerActive}},
+		{name: "idle", current: params.RunnerIdle, want: []params.RunnerStatus{params.RunnerActive}},
+		{name: "active retry", current: params.RunnerActive, want: []params.RunnerStatus{params.RunnerActive}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			got := nddevDirectJITStartedTransitions(test.current)
+			if len(got) != len(test.want) {
+				t.Fatalf("transition count = %d, want %d", len(got), len(test.want))
+			}
+			for index, want := range test.want {
+				if got[index] != want {
+					t.Fatalf("transition %d = %q, want %q", index, got[index], want)
+				}
+			}
+		})
+	}
+}
+
+func TestNDDevDirectJITStartedTransitionsAreLegal(t *testing.T) {
+	for _, current := range []params.RunnerStatus{
+		params.RunnerPending,
+		params.RunnerInstalling,
+		params.RunnerIdle,
+		params.RunnerActive,
+	} {
+		next := current
+		for _, transition := range nddevDirectJITStartedTransitions(current) {
+			if transition != next && !slices.Contains(params.RunnerStatusTransitions[next], transition) {
+				t.Fatalf("illegal transition from %q to %q", next, transition)
+			}
+			next = transition
+		}
+		if next != params.RunnerActive {
+			t.Fatalf("final status from %q = %q, want %q", current, next, params.RunnerActive)
+		}
+	}
+}
