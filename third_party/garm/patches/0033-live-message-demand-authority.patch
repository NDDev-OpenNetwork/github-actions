+func TestInvalidateAllowsReplacementSessionDemand(t *testing.T) {
+	w := &Worker{ctx: context.Background()}
+	t0 := time.Date(2026, 9, 7, 12, 0, 0, 0, time.UTC)
+	if err := w.ObserveLiveMessageDemand("sess-old", 0, 9, t0); err != nil {
+		t.Fatal(err)
+	}
+	w.InvalidateLiveMessageDemand()
+	if err := w.ObserveLiveMessageDemand("sess-new", 3, 1, t0.Add(time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	got := w.liveMessageDemand()
+	if got.sessionID != "sess-new" || got.assigned != 3 || got.messageID != 1 {
+		t.Fatalf("replacement session was refused: %#v", got)
+	}
+}
