+func TestFailedScaleSetInstanceAcceptsAnAlreadyDeletedAuthoritativeRow(t *testing.T) {
+	helper := &failedScaleSetRunnerCleanupHelper{instance: params.Instance{
+		Name: "runner-failed", Status: commonParams.InstanceDeleted, ScaleSetID: 1, AgentID: 322,
+	}}
+	manager := failedScaleSetInstanceManager(helper)
+
+	if err := manager.consolidateState(); !errors.Is(err, ErrInstanceDeleted) {
+		t.Fatalf("consolidating terminal instance: %v", err)
+	}
+	if helper.getCalls != 1 || helper.removeCalls != 0 || helper.statusCalls != 0 {
+		t.Fatalf("terminal row was mutated: get=%d remove=%d status=%d", helper.getCalls, helper.removeCalls, helper.statusCalls)
+	}
+	if manager.instance.Status != commonParams.InstanceDeleted {
+		t.Fatalf("local status=%s, want %s", manager.instance.Status, commonParams.InstanceDeleted)
+	}
+}
