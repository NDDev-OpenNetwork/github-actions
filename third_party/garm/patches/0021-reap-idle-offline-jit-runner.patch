+package scaleset
+
+import (
+	"testing"
+
+	"github.com/cloudbase/garm/params"
+)
+
+func TestTimedOutRunnerIsReapable(t *testing.T) {
+	t.Parallel()
+
+	tests := map[string]struct {
+		local   params.RunnerStatus
+		remote  params.RunnerStatus
+		present bool
+		want    bool
+	}{
+		"idle absent":        {params.RunnerIdle, params.RunnerUnknown, false, true},
+		"idle offline":       {params.RunnerIdle, params.RunnerOffline, true, true},
+		"idle online":        {params.RunnerIdle, params.RunnerIdle, true, false},
+		"pending absent":     {params.RunnerPending, params.RunnerUnknown, false, true},
+		"installing offline": {params.RunnerInstalling, params.RunnerOffline, true, true},
+		"active absent":      {params.RunnerActive, params.RunnerUnknown, false, false},
+		"active offline":     {params.RunnerActive, params.RunnerOffline, true, false},
+		"unknown absent":     {params.RunnerUnknown, params.RunnerUnknown, false, false},
+		"pending online":     {params.RunnerPending, params.RunnerIdle, true, false},
+	}
+
+	for name, test := range tests {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			if got := timedOutRunnerIsReapable(test.local, test.remote, test.present); got != test.want {
+				t.Fatalf("timedOutRunnerIsReapable(%q, %q, %t) = %t, want %t", test.local, test.remote, test.present, got, test.want)
+			}
+		})
+	}
+}
