+// timedOutRunnerIsReapable keeps timeout cleanup fail closed on GitHub state.
+// A JIT runner can connect, become idle, and then be removed by GitHub without
+// ever receiving a job. In that case the old pending/installing-only predicate
+// left both the GARM row and provider instance alive forever. An explicit
+// absent or offline GitHub observation after the scale-set timeout is
+// authoritative for an idle ephemeral runner. Active and unknown local states
+// are always retained.
+func timedOutRunnerIsReapable(local params.RunnerStatus, remote params.RunnerStatus, present bool) bool {
+	if present && remote != params.RunnerOffline {
+		return false
+	}
+	switch local {
+	case params.RunnerPending, params.RunnerInstalling, params.RunnerIdle:
+		return true
+	default:
+		return false
+	}
+}
