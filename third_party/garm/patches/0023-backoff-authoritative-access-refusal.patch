 }
 
+const authoritativeReconcileAccessBackoff = 15 * time.Minute
+
+func authoritativeReconcileBackoff(status int) time.Duration {
+	switch status {
+	case http.StatusForbidden, http.StatusTooManyRequests:
+		return authoritativeReconcileAccessBackoff
+	default:
+		return 0
+	}
+}
+
+func (r *basePoolManager) deferAuthoritativeReconcile(now time.Time, status int) bool {
+	delay := authoritativeReconcileBackoff(status)
+	if delay == 0 {
+		return false
+	}
+	r.mux.Lock()
+	defer r.mux.Unlock()
+	until := now.Add(delay)
+	if until.After(r.authoritativeReconcileBlockedUntil) {
+		r.authoritativeReconcileBlockedUntil = until
+	}
+	return true
+}
+
+func (r *basePoolManager) authoritativeReconcileDeferred(now time.Time) bool {
+	r.mux.Lock()
+	defer r.mux.Unlock()
+	return now.Before(r.authoritativeReconcileBlockedUntil)
+}
