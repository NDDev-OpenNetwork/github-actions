+func (s *sqlDatabase) DeleteScaleSetJob(_ context.Context, scaleSetJobID string) error {
+	var removedJob params.Job
+	err := s.conn.Transaction(func(tx *gorm.DB) error {
+		var workflowJob WorkflowJob
+		q := tx.Where("scale_set_job_id = ?", scaleSetJobID).Preload("Instance").First(&workflowJob)
+		if q.Error != nil {
+			if errors.Is(q.Error, gorm.ErrRecordNotFound) {
+				return nil
+			}
+			return fmt.Errorf("error fetching scale set job: %w", q.Error)
+		}
+		var err error
+		removedJob, err = sqlWorkflowJobToParamsJob(workflowJob)
+		if err != nil {
+			return fmt.Errorf("error converting scale set job: %w", err)
+		}
+		if q = tx.Delete(&workflowJob); q.Error != nil {
+			return fmt.Errorf("error deleting scale set job: %w", q.Error)
+		}
+		return nil
+	})
+	if err != nil {
+		return err
+	}
+	if removedJob.ID != 0 {
+		if notifyErr := s.sendNotify(common.JobEntityType, common.DeleteOperation, removedJob); notifyErr != nil {
+			slog.With(slog.Any("error", notifyErr)).Error("failed to send notify")
+		}
+	}
+	return nil
+}
