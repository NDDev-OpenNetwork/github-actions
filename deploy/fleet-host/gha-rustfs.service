[Unit]
Description=NDDev RustFS cache object store
After=network-online.target incus.service
Wants=network-online.target
Requires=incus.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
User=gha-rustfs
Group=gha-rustfs
UMask=0077
LoadCredential=rustfs-access-key:/etc/gha-fleet/secrets/rustfs-access-key
LoadCredential=rustfs-secret-key:/etc/gha-fleet/secrets/rustfs-secret-key
LoadCredential=rustfs-rpc-secret:/etc/gha-fleet/secrets/rustfs-rpc-secret
LoadCredential=rustfs_cert.pem:/etc/gha-fleet/pki/cache/rustfs-cert.pem
LoadCredential=rustfs_key.pem:/etc/gha-fleet/pki/cache/rustfs-key.pem
Environment=RUSTFS_ADDRESS=192.0.2.1:9002
Environment=RUSTFS_ACCESS_KEY_FILE=/run/credentials/gha-rustfs.service/rustfs-access-key
Environment=RUSTFS_SECRET_KEY_FILE=/run/credentials/gha-rustfs.service/rustfs-secret-key
Environment=RUSTFS_TLS_PATH=/run/credentials/gha-rustfs.service
Environment=RUSTFS_REGION=us-east-1
Environment=RUSTFS_CONSOLE_ENABLE=false
Environment=RUSTFS_SFTP_ENABLE=false
Environment=RUSTFS_FTPS_ENABLE=false
Environment=RUSTFS_WEBDAV_ENABLE=false
Environment=RUSTFS_SWIFT_ENABLE=false
Environment=RUSTFS_OBS_ENVIRONMENT=production
Environment=RUSTFS_OBS_LOGGER_LEVEL=warn
Environment=RUSTFS_OBS_LOG_DIRECTORY=/var/lib/gha-cache/rustfs/logs
Environment=RUSTFS_OBS_LOG_STDOUT_ENABLED=true
Environment=RUSTFS_OBS_LOG_ROTATION_TIME=hourly
Environment=RUSTFS_OBS_LOG_KEEP_FILES=48
Environment=RUSTFS_OBS_LOG_MAX_TOTAL_SIZE_BYTES=536870912
Environment=RUSTFS_OBS_LOG_MAX_SINGLE_FILE_SIZE_BYTES=67108864
Environment=RUSTFS_OBS_LOG_COMPRESSED_FILE_RETENTION_DAYS=7
Environment=RUSTFS_OBS_LOG_CLEANUP_INTERVAL_SECONDS=900
Environment=RUSTFS_OBS_LOG_MIN_FILE_AGE_SECONDS=3600
Environment=RUSTFS_OBS_LOG_PARALLEL_WORKERS=2
Environment=RUSTFS_OBS_LOG_ZSTD_WORKERS=1
Environment=RUSTFS_OBS_TRACES_EXPORT_ENABLED=false
Environment=RUSTFS_OBS_METRICS_EXPORT_ENABLED=false
Environment=RUSTFS_OBS_LOGS_EXPORT_ENABLED=false
Environment=RUSTFS_OBS_PROFILING_EXPORT_ENABLED=false
ExecStartPre=/usr/local/libexec/gha-fleet/cache-network-ready gha0 120
ExecStart=/usr/local/libexec/gha-fleet/rustfs-launcher
Restart=always
RestartSec=2s
TimeoutStartSec=150s
TimeoutStopSec=90s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_NETLINK
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=192.0.2.0/24
SystemCallArchitectures=native
ReadWritePaths=/var/lib/gha-cache/rustfs
MemoryAccounting=true
MemoryHigh=3G
MemoryMax=4G
TasksAccounting=true
TasksMax=1024
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
