# Rendered secrets replace only the two @...@ tokens below. This template is
# otherwise installed byte-for-byte as /etc/garm/config.toml.

[default]
  callback_url = "https://192.0.2.1:9443/api/v1/callbacks"
  metadata_url = "https://192.0.2.1:9443/api/v1/metadata"
  webhook_url = "http://127.0.0.1:9997/webhooks"
  enable_webhook_management = false
  enable_log_streamer = false
  debug_server = false

[logging]
  enable_log_streamer = false
  log_format = "json"
  log_level = "info"
  log_source = false

[metrics]
  enable = true
  disable_auth = false
  period = "30s"

[jwt_auth]
  secret = "@GARM_JWT_SECRET@"
  time_to_live = "24h"

[apiserver]
  bind = "127.0.0.1"
  port = 9997
  use_tls = false

  [apiserver.webui]
    enable = false

[database]
  debug = false
  backend = "sqlite3"
  passphrase = "@GARM_DATABASE_PASSPHRASE@"

  [database.sqlite3]
    db_file = "/var/lib/garm/garm.db"
    busy_timeout_seconds = 5

[[provider]]
  name = "nddev-incus"
  provider_type = "external"
  description = "Hardened NDDev Incus full-VM provider"
  disable_jit_config = false

  [provider.external]
    interface_version = "v0.1.0"
    provider_executable = "/usr/local/libexec/gha-fleet/garm-provider-incus-nddev"
    config_file = "/etc/garm/provider-incus.toml"
    # GARM intentionally gives external providers a clean environment. The
    # provider's read-only host probe uses a fixed systemd PATH for uname,
    # findmnt, lsblk, Incus, Docker and systemctl.
    environment_variables = ["PATH"]
